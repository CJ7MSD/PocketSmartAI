APP_NAME=PocketSmart AI
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./pocketsmart.db

# Gemini is optional. Used for AI ranking/summaries and jewelry image analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional live shopping. Create a SerpApi private API key and set it here.
# Without it, the app uses the bundled demo catalog.
SERPAPI_API_KEY=
LIVE_RECOMMENDATIONS=true

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
